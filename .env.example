# Copy this file to .env and fill in your values
# Never commit .env to version control

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — Supabase PostgreSQL (required; SQLite is not supported)
# Option A: paste the connection string from Supabase Dashboard → Database → Connection string
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Option B: individual vars (DB_HOST is auto-derived from SUPABASE_URL if omitted)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db.xxxx.supabase.co
DB_PORT=5432
DB_SCHEMA=django
DB_SSLMODE=require

# Supabase API — shared data store with Aeropt-agent (dashboard + concept proficiency)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU


# Groq (LLM for Study Session chatbot)
GROQ_API_KEY=gsk_...
GROQ_API_BASE=https://api.groq.com/openai/v1
CHATBOT_MODEL=llama-3.3-70b-versatile
CHATBOT_MAX_TOKENS=1000
DEV_AUTH_BYPASS=False
DEV_AUTH_BYPASS_USERNAME=chatbot-dev
DEV_AUTH_BYPASS_EMAIL=chatbot-dev@local.test

# CORS — frontend origin(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Agent service. Home fills a missing today from this base. Unset means provisional.
AGENT_API_BASE_URL=http://127.0.0.1:8001

# Email (for verify-email / forgot-password flows)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Prepwise <no-reply@prepwise.com>
