# Copy this file to .env and fill in your values
# Never commit .env to version control

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — Supabase PostgreSQL (required; SQLite is not supported)
# Option A: paste the connection string from Supabase Dashboard → Database → Connection string
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Option B: individual vars (DB_HOST is auto-derived from SUPABASE_URL if omitted)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-database-password
DB_HOST=db.xxxx.supabase.co
DB_PORT=5432
DB_SCHEMA=django
DB_SSLMODE=require

# Supabase API — shared data store with Aeropt-agent (dashboard + concept proficiency)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-service-role-key

# Redis (Celery broker + Django cache)
REDIS_URL=redis://localhost:6379/0

# Groq (LLM for Study Session chatbot)
GROQ_API_KEY=gsk_...
GROQ_API_BASE=https://api.groq.com/openai/v1
CHATBOT_MODEL=llama-3.3-70b-versatile
CHATBOT_MAX_TOKENS=1000
CHATBOT_AUTH_DISABLED=False
CHATBOT_DEV_USERNAME=chatbot-dev
CHATBOT_DEV_EMAIL=chatbot-dev@local.test

# CORS — frontend origin(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email (for verify-email / forgot-password flows)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Prepwise <no-reply@prepwise.com>
