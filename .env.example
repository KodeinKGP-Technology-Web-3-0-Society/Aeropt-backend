# Copy this file to .env and fill in your values
# Never commit .env to version control

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (switch from SQLite to PostgreSQL in production)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=prepwise
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Redis (Celery broker + Django cache)
REDIS_URL=redis://localhost:6379/0

# Anthropic (LLM for Study Session chatbot)
ANTHROPIC_API_KEY=sk-ant-...

# CORS — frontend origin(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email (for verify-email / forgot-password flows)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Prepwise <no-reply@prepwise.com>
