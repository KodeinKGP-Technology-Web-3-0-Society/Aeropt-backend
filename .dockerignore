# Keep the build context small and never bake secrets or local state into a layer.
.git
.github
.gitignore

# Secrets / local config
.env
.env.*
!.env.example

# Virtualenvs
.venv
venv
env

# Python bytecode / caches
__pycache__
**/__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache

# Local databases and CI artifacts
*.sqlite3
.ci.sqlite3
staticfiles
media
htmlcov
.coverage
.coverage.*

# Editor / OS noise
.idea
.vscode
.DS_Store

# Docs and deploy files not needed at runtime
Dockerfile
.dockerignore
README.md
